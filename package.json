{
  "name": "resqr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.10",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  }
}
